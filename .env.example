OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Alias for new secret keys:
# SUPABASE_SECRET_KEY=sb_secret_...

# Auth session signing (min 32 characters)
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Stripe — $5/month subscription (CourseMap Pro)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel): https://www.coursemap.live
# Optional override for session cookies:
# COOKIE_DOMAIN=coursemap.live
